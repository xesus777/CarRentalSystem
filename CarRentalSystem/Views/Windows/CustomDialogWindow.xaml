<Window x:Class="CarRentalSystem.Views.Windows.CustomDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarRentalSystem.Views.Windows"
        mc:Ignorable="d"
        Title="Кастомное диалговое окно" Height="200" Width="420"
        WindowStartupLocation="CenterOwner" WindowStyle="None" 
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border Background="{DynamicResource BgCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="TxtMessage" Grid.Column="1" Text="Текст сообщения..." FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="BtnNo" Content="Нет" Width="85" Height="32" Margin="0,0,10,0" Background="{DynamicResource BrushMuted}" Foreground="{DynamicResource TextLight}" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnNo_Click" Visibility="Collapsed"/>
                <Button Name="BtnYes" Content="Да" Width="85" Height="32" Background="{DynamicResource BrushDanger}" Foreground="{DynamicResource TextLight}" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnYes_Click" Visibility="Collapsed"/>
                <Button Name="BtnOk" Content="ОК" Width="95" Height="32" Background="{DynamicResource BgPanelAccent}" Foreground="{DynamicResource TextLight}" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnOk_Click" Visibility="Visible"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
