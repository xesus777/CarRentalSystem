<Page x:Class="CarRentalSystem.Views.Pages.ActiveMonitoringPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarRentalSystem.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Мониторинг аренды">

    <Grid Background="{DynamicResource BgWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="СВОДНЫЙ МОНИТОРИНГ ТРАНСПОРТНЫХ СРЕДСТВ В АРЕНДЕ" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="5,0,0,15"/>

        <DataGrid Grid.Row="1" Name="GridGlobalActive" AutoGenerateColumns="False" IsReadOnly="True" Background="{DynamicResource BgCard}" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Договор" Binding="{Binding ID_Order}" Width="Auto"/>
                <DataGridTextColumn Header="Арендатор (ФИО)" Binding="{Binding ClientName}" Width="Auto"/>
                <DataGridTextColumn Header="Контакты" Binding="{Binding ClientPhone}" Width="Auto"/>
                <DataGridTextColumn Header="Автомобиль" Binding="{Binding CarInfo}" Width="Auto"/>
                <DataGridTextColumn Header="Госномер" Binding="{Binding LicensePlate}" Width="Auto"/>
                <DataGridTextColumn Header="Дата выдачи" Binding="{Binding StartDate, StringFormat={}{0:dd.MM.yyyy}}" Width="Auto"/>
                <DataGridTextColumn Header="Дата возврата" Binding="{Binding EndDate, StringFormat={}{0:dd.MM.yyyy}}" Width="Auto"/>
                <DataGridTextColumn Header="Осталось" Binding="{Binding TimeLeft}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
