<Page x:Class="CarRentalSystem.Views.Pages.AdminAnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarRentalSystem.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Админ - Статистика">

    <Grid Background="{DynamicResource BgWindow}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource BgCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="15" Margin="0,0,20,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="СВОДНАЯ СТАТИСТИКА" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15"/>

                <Border Background="{DynamicResource BgWindow}" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Всего заработано:" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Name="TxtTotalEarned" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgWindow}" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Активных машин в прокате:" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Name="TxtRentedCarsCount" Text="0 авто" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource BgCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="График финансовых поступлений по месяцам (текущий год)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15"/>

                <Border Grid.Row="1" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1,0,0,1" Margin="30,10,20,30">
                    <Canvas Name="ChartCanvas" Background="{DynamicResource BgWindow}" SizeChanged="ChartCanvas_SizeChanged"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
