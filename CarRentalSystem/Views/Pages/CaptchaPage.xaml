<Page x:Class="CarRentalSystem.Views.Pages.CaptchaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarRentalSystem.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Каптча">

    <Grid Background="{DynamicResource BgWindow}">
        <Border Background="{DynamicResource BgCard}" Width="400" Height="Auto" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Margin="25" VerticalAlignment="Center">
                <TextBlock Text="ПОДТВЕРДИТЕ, ЧТО ВЫ НЕ РОБОТ" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Background="#F5F6F9" Height="65" Width="220" HorizontalAlignment="Center">
                    <Image Name="ImgCaptcha" Stretch="Uniform"/>
                </Border>

                <Button Content="Обновить картинку" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource CarItemTypeColor}" FontSize="11" Cursor="Hand" Margin="0,5,0,20" HorizontalAlignment="Center" Click="BtnRefresh_Click"/>

                <TextBox Name="TxtCaptchaInput" Width="220" Height="35" FontSize="14" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,0,20" MaxLength="5"/>

                <Button Name="SubmitCaptcha" Content="Проверить код" Height="38" Width="220" Background="{DynamicResource BgPanelAccent}" Foreground="White" FontWeight="SemiBold" Click="SubmitCaptcha_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
