<Page x:Class="CarRentalSystem.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarRentalSystem.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Настройки" Loaded="Page_Loaded">

    <Grid Background="{DynamicResource BgWindow}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">

            <Button Content="Назад в профиль" HorizontalAlignment="Left" Width="130" Height="28" Margin="0,0,0,20" Click="BtnBack_Click"/>

            <TextBlock Text="НАСТРОЙКИ ПРИЛОЖЕНИЯ" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,25" Foreground="{DynamicResource TextPrimary}"/>

            <Grid Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="Темная тема интерфейса:" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtThemeStatus" Text="Выключена" Foreground="{DynamicResource BrushMuted}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <ToggleButton Name="ToggleTheme" 
                              Style="{DynamicResource RoundToggleSwitchStyle}" 
                              HorizontalAlignment="Right" 
                              VerticalAlignment="Center"
                              Checked="ToggleTheme_Checked" 
                              Unchecked="ToggleTheme_Unchecked"/>
            </Grid>

            <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Margin="0,0,0,15" Padding="0,0,0,5"/>
            <TextBlock Text="БЕЗОПАСНОСТЬ И ПАРОЛЬ" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource BgPanelAccent}"/>

            <TextBlock Text="Текущий пароль:" Foreground="{DynamicResource TextSecondary}"/>
            <PasswordBox Name="TxtOldPassword" Height="30" Margin="0,2,0,10"/>

            <TextBlock Text="Новый пароль:" Foreground="{DynamicResource TextSecondary}"/>
            <PasswordBox Name="TxtNewPassword" Height="30" Margin="0,2,0,15"/>

            <Button Content="Сохранить новый пароль" Height="35" Background="{DynamicResource BgPanelAccent}" Foreground="White" FontWeight="Bold" Click="BtnChangePassword_Click"/>

        </StackPanel>
    </Grid>
</Page>
