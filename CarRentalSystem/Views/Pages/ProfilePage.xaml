<Page x:Class="CarRentalSystem.Views.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarRentalSystem.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Профиль">

    <Grid Background="{DynamicResource BgWindow}" Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource BgCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="15" Margin="0,0,15,0">
            <StackPanel>
                <TextBlock Name="TxtUserLogin" Text="Логин: -" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Name="TxtClientLastName" Text="Фамилия: -" Margin="0,4" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Name="TxtClientFirstName" Text="Имя: -" Margin="0,4" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Name="TxtClientMiddleName" Text="Отчество: -" Margin="0,4" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Name="TxtClientPhone" Text="Телефон: -" Margin="0,4" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Name="TxtClientPassport" Text="Паспорт: -" Margin="0,4" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Name="TxtClientLicense" Text="Вод. удостоверение: -" Margin="0,4" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>

                <Button Content="Настройки" Height="30" Margin="0,20,0,5" Click="BtnGoToSettings_Click"/>
                <Button Content="В каталог" Height="30" Click="BtnBack_Click" Background="{DynamicResource BrushMuted}"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Column="1" Background="{DynamicResource BgCard}" Style="{DynamicResource {x:Type TabControl}}">
            <TabItem Header=" История всех заказов " Padding="12,5" Style="{DynamicResource {x:Type TabItem}}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Name="GridOrders" AutoGenerateColumns="False" IsReadOnly="True" Background="{DynamicResource BgCard}" GridLinesVisibility="Horizontal" Style="{DynamicResource {x:Type DataGrid}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding ID_Order}" Width="40"/>
                            <DataGridTextColumn Header="Марка" Binding="{Binding CarBrand}" Width="100"/>
                            <DataGridTextColumn Header="Модель" Binding="{Binding CarModel}" Width="100"/>
                            <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                            <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                            <DataGridTextColumn Header="Стоимость" Binding="{Binding TotalCost, StringFormat={}{0:C}}" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="Отменить выбранное бронирование" Height="35" Margin="0,10,0,0" Background="{DynamicResource BrushDanger}" Foreground="White" FontWeight="SemiBold" Click="BtnCancelOrder_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header=" Активные аренды " Padding="12,5" Style="{DynamicResource {x:Type TabItem}}">
                <Grid Margin="10">
                    <DataGrid Name="GridActiveOrders" AutoGenerateColumns="False" IsReadOnly="True" Background="{DynamicResource BgCard}" GridLinesVisibility="Horizontal" Style="{DynamicResource {x:Type DataGrid}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Договор" Binding="{Binding ID_Order}" Width="60"/>
                            <DataGridTextColumn Header="Автомобиль" Binding="{Binding CarInfo}" Width="150"/>
                            <DataGridTextColumn Header="Госномер" Binding="{Binding LicensePlate}" Width="100"/>
                            <DataGridTextColumn Header="Дата выдачи" Binding="{Binding StartDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                            <DataGridTextColumn Header="Срок возврата" Binding="{Binding EndDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                            <DataGridTextColumn Header="Осталось времени" Binding="{Binding TimeLeft}" Width="140"/>
                            <DataGridTextColumn Header="Сумма контракта" Binding="{Binding TotalCost, StringFormat={}{0:C}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
