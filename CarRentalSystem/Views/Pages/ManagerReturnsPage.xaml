<Page x:Class="CarRentalSystem.Views.Pages.ManagerReturnsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarRentalSystem.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Менеджер - Прием авто">

    <Grid Background="{DynamicResource BgWindow}" Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="АВТОМОБИЛИ, ОЖИДАЮЩИЕ ПРИЕМКИ С АРЕНДЫ" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>

            <DataGrid Grid.Row="1" Name="GridExpiredOrders" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" SelectionChanged="GridExpiredOrders_SelectionChanged" Style="{DynamicResource {x:Type DataGrid}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding ID_Order}" Width="40"/>
                    <DataGridTextColumn Header="Автомобиль" Binding="{Binding CarInfo}" Width="160"/>
                    <DataGridTextColumn Header="Госномер" Binding="{Binding LicensePlate}" Width="100"/>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="140"/>
                    <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource BgCard}" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="15" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="ФИКСАЦИЯ ПРИЕМКИ АВТО" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Name="TxtSelectedCar" Text="Машина не выбрана" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource CarItemTypeColor}" Margin="0,0,0,15" TextWrapping="Wrap"/>

                <TextBlock Text="Состояние транспортного средства:" Foreground="{DynamicResource FormLabelText}" Margin="0,5,0,5"/>

                <RadioButton Name="RadioStatusOk" Content="Всё отлично (Вернуть в каталог)" IsChecked="True" Margin="0,2,0,5" Foreground="{DynamicResource TextPrimary}" Checked="RadioStatus_Changed"/>
                <RadioButton Name="RadioStatusDamaged" Content="Требуется ремонт / Обнаружены дефекты" Margin="0,2,0,10" Foreground="{DynamicResource TextPrimary}" Checked="RadioStatus_Changed"/>

                <StackPanel Name="PanelDamageDescription" Visibility="Collapsed">
                    <TextBlock Text="Описание повреждений / неисправностей:" Foreground="{DynamicResource FormLabelText}" Margin="0,5,0,2"/>
                    <TextBox Name="TxtDamageDescription" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="5"/>
                </StackPanel>

                <Button Name="BtnConfirmReturn" Content="Зафиксировать возврат авто" Height="40" Margin="0,20,0,0" Background="{DynamicResource BgPanelAccent}" Foreground="White" FontWeight="Bold" Click="BtnConfirmReturn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
