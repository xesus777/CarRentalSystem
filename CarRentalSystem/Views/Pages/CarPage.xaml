<Page x:Class="CarRentalSystem.Views.Pages.CarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarRentalSystem.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авто">

    <Grid Background="{DynamicResource BgWindow}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="{DynamicResource BgCard}" Margin="30" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="20" HorizontalAlignment="Center" Width="650">
                <StackPanel>

                    <Button Content="Назад в каталог" HorizontalAlignment="Left" Width="130" Height="30" Click="BtnBack_Click"/>

                    <TextBlock Name="TxtCarTitle" Text="Марка Модель" FontSize="24" FontWeight="Bold" Margin="0,20,0,5" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Name="TxtCategory" Text="Класс: -" FontSize="16" Foreground="{DynamicResource CarItemTypeColor}" FontWeight="Bold" Margin="0,0,0,20"/>

                    <!-- ИСПРАВЛЕНО: Stretch="Uniform" гарантирует, что авто влезет ПОЛНОСТЬЮ без обрезки краев -->
                    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource BgWindow}" Height="340" Margin="0,0,0,20" ClipToBounds="True">
                        <Image Name="ImgCarPhoto" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="0,5">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Год выпуска: " FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Name="TxtYear" Text="-" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Государственный номер: " FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Name="TxtPlate" Text="-" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Стоимость одних суток: " FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Name="TxtPrice" Text="-" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource CarStatusText}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Перейти к оформлению аренды" Height="42" Margin="0,25,0,0" Background="{DynamicResource BgPanelAccent}" Foreground="White" FontWeight="Bold" FontSize="14" Click="BtnRent_Click"/>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
