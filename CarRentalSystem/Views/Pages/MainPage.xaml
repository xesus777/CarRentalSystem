<Page x:Class="CarRentalSystem.Views.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarRentalSystem.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Старотовая страница">

    <Grid Background="{DynamicResource BgWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="15,15,15,10">
            <Button Name="BtnGuestBack" Content="На главную / Войти" Width="150" Height="28" Margin="0,0,20,0" Background="{DynamicResource BrushDanger}" Foreground="White" FontWeight="SemiBold" Visibility="Collapsed" Click="BtnGuestBack_Click"/>

            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource TextPrimary}"/>
            <TextBox Name="TxtSearch" Width="180" Height="28" VerticalContentAlignment="Center" TextChanged="FilterCriteria_Changed"/>

            <TextBlock Text="Класс:" VerticalAlignment="Center" Margin="15,0,5,0" Foreground="{DynamicResource TextPrimary}"/>
            <ComboBox Name="ComboCategory" Width="130" Height="28" SelectionChanged="FilterCriteria_Changed">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding CategoryName}" Foreground="{DynamicResource TextPrimary}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Цена:" VerticalAlignment="Center" Margin="15,0,5,0" Foreground="{DynamicResource TextPrimary}"/>
            <ComboBox Name="ComboSort" Width="150" Height="28" SelectionChanged="FilterCriteria_Changed">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="Сначала дешевые"/>
                <ComboBoxItem Content="Сначала дорогие"/>
            </ComboBox>
        </StackPanel>

        <ListView Name="ListCars" Grid.Row="1" Margin="10,0,10,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" BorderBrush="Transparent" Background="Transparent">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="5" Margin="8" Width="260" Background="{DynamicResource BgCard}" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding Brand}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Model}" FontSize="16" Foreground="{DynamicResource CarItemSecondaryText}" Margin="0,0,0,5"/>

                            <Border Height="140" Margin="0,5" CornerRadius="4" Background="{DynamicResource BgWindow}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" ClipToBounds="True">
                                <Image Source="{Binding CarImagePath, TargetNullValue='/Images/no_photo.png', FallbackValue='/Images/no_photo.png'}" Stretch="UniformToFill"/>
                            </Border>

                            <Border Background="{DynamicResource CarStatusBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="3" Padding="5" Margin="0,5">
                                <Grid>
                                    <TextBlock Text="{Binding CarCategories.CategoryName}" FontWeight="Bold" Foreground="{DynamicResource CarItemTypeColor}"/>
                                    <TextBlock Text="{Binding CarCategories.PricePerDay, StringFormat={}{0:C}/сут}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource CarStatusText}"/>
                                </Grid>
                            </Border>
                            <Button Content="Подробнее" Height="30" Margin="0,10,0,0" Background="{DynamicResource BgPanelAccent}" Tag="{Binding ID_Car}" Click="BtnViewCar_Click"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
