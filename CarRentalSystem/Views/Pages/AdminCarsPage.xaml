<Page x:Class="CarRentalSystem.Views.Pages.AdminCarsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarRentalSystem.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Админ - управление каталогом">

    <Grid Background="{DynamicResource BgWindow}">
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox Name="TxtSearchCar" Width="200" Height="28" VerticalContentAlignment="Center" TextChanged="TxtSearchCar_TextChanged"/>
                </StackPanel>

                <ListView Name="ListAdminCars" Grid.Row="1" SelectionChanged="ListAdminCars_SelectionChanged" HorizontalContentAlignment="Stretch" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BrushBorder}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="60" Height="45" Background="#F0F2F5" CornerRadius="4" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" HorizontalAlignment="Left">
                                        <Image Source="{Binding CarImagePath, TargetNullValue='/Images/no_photo.png', FallbackValue='/Images/no_photo.png'}" Stretch="UniformToFill"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Brand}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Model}" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LicensePlate}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding ManufactureYear, StringFormat={}Год: {0}}" FontSize="11" Foreground="{DynamicResource BrushMuted}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding CarCategories.CategoryName}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource BgPanelAccent}"/>

                                    <Border Grid.Column="4" CornerRadius="4" Padding="6,4" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource BgWindow}" BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}">
                                        <TextBlock Text="{Binding CarStatuses.StatusName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BgPanelAccent}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource BgCard}" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Name="TxtFormTitle" Text="ДОБАВЛЕНИЕ / ИЗМЕНЕНИЕ АВТО" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="Фотография автомобиля:" Margin="0,0,0,2" Foreground="{DynamicResource TextSecondary}"/>
                        <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Height="140" CornerRadius="4" Background="{DynamicResource BgWindow}" Margin="0,0,0,8">
                            <Image Name="ImgFormPhoto" Stretch="Uniform"/>
                        </Border>
                        <Button Name="BtnSelectPhoto" Content="📁 Выбрать фото через проводник" Height="28" Margin="0,0,0,15" Background="{DynamicResource BrushMuted}" Click="BtnSelectPhoto_Click"/>

                        <TextBlock Text="Марка (Бренд):" Margin="0,5,0,2" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox Name="TxtBrand" Height="30" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Model:" Margin="0,8,0,2" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox Name="TxtModel" Height="30" VerticalContentAlignment="Center"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="Год выпуска:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"/>
                                <TextBox Name="TxtYear" Height="30" VerticalContentAlignment="Center" MaxLength="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Госномер:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"/>
                                <TextBox Name="TxtPlate" Height="30" VerticalContentAlignment="Center" MaxLength="15"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Класс / Категория цены:" Margin="0,8,0,2" Foreground="{DynamicResource TextSecondary}"/>
                        <ComboBox Name="ComboFormCategory" Height="30">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CategoryName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Статус автомобиля:" Margin="0,8,0,2" Foreground="{DynamicResource TextSecondary}"/>
                        <ComboBox Name="ComboFormStatus" Height="30">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Margin="0,20,0,0">
                            <Button Name="BtnAddCar" Content="Добавить новый автомобиль" Height="35" Click="BtnAddCar_Click"/>
                            <Button Name="BtnEditCar" Content="Сохранить изменения" Height="35" Margin="0,8,0,0" Background="{DynamicResource BgPanelAccent}" Click="BtnEditCar_Click"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Очистить форму" Height="30" Margin="0,0,5,0" Background="{DynamicResource BrushMuted}" Click="BtnClearForm_Click"/>
                                <Button Content="Удалить авто" Height="30" Grid.Column="1" Margin="5,0,0,0" Background="{DynamicResource BrushDanger}" Click="BtnDeleteCar_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
