<Page x:Class="CarRentalSystem.Views.Pages.ManagerOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarRentalSystem.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Менеджер - Заявки" Loaded="Page_Loaded">

    <Grid Background="{DynamicResource BgWindow}">
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            
            <TabControl Grid.Column="0" Name="TabOrders" Margin="0,0,15,0" SelectionChanged="TabOrders_SelectionChanged" Style="{DynamicResource {x:Type TabControl}}">
                <TabItem Header=" Новые заявки " Padding="15,6" Style="{DynamicResource {x:Type TabItem}}">
                    <DataGrid Name="GridNewOrders" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" Style="{DynamicResource {x:Type DataGrid}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding ID_Order}" Width="auto"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="150"/>
                            <DataGridTextColumn Header="Марка" Binding="{Binding CarBrand}" Width="100"/>
                            <DataGridTextColumn Header="Модель" Binding="{Binding CarModel}" Width="100"/>
                            <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                            <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                            <DataGridTextColumn Header="Стоимость" Binding="{Binding TotalCost, StringFormat={}{0:C}}" Width="100"/>
                            <DataGridTextColumn Header="Статус заказа" Binding="{Binding StatusName}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header=" Заявки на отмену" Padding="15,6" Style="{DynamicResource {x:Type TabItem}}">
                    <DataGrid Name="GridCancelOrders" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" Style="{DynamicResource {x:Type DataGrid}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding ID_Order}" Width="40"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="150"/>
                            <DataGridTextColumn Header="Марка" Binding="{Binding CarBrand}" Width="100"/>
                            <DataGridTextColumn Header="Модель" Binding="{Binding CarModel}" Width="100"/>
                            <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                            <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                            <DataGridTextColumn Header="Стоимость" Binding="{Binding TotalCost, StringFormat={}{0:C}}" Width="100"/>
                            <DataGridTextColumn Header="Статус заказа" Binding="{Binding StatusName}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <Border Grid.Column="1" Background="{DynamicResource BgCard}" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="15" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Name="PanelNewActions" Visibility="Visible">
                        <TextBlock Text="РАССМОТРЕНИЕ БРОНИ" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimary}"/>
                        <Button Content="Одобрить аренду" Height="35" Margin="0,5" Click="BtnApprove_Click"/>
                        <Button Content="Отклонить заявку" Height="35" Margin="0,5" Background="{DynamicResource BrushDanger}" Click="BtnReject_Click"/>
                    </StackPanel>

                    <StackPanel Name="PanelCancelActions" Visibility="Collapsed">
                        <TextBlock Text="УДЕРЖАНИЕ СРЕДСТВ" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource BrushDanger}"/>
                        <Button Content="Подтвердить отмену " Height="40" Margin="0,5" Background="{DynamicResource BrushDanger}" FontWeight="Bold" Click="BtnConfirmCancelWithPenalty_Click"/>
                        <Button Content="Отклонить отмену" Height="35" Margin="0,5" Background="{DynamicResource BrushMuted}" Click="BtnRejectCancelRequest_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
